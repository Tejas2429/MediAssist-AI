# MediAssist AI - Environment Configuration Template
# Copy this file to .env and configure your credentials

# 1. Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Gemini Model (Optional, defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# 3. Security (JWT Secret Key for Clinician authentication)
SECRET_KEY=generate_a_secure_random_key_here

# 4. Database URL (Default is SQLite for local development, PostgreSQL for production)
# SQLite:
DATABASE_URL=sqlite:///./mediassist.db
# PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediassist
